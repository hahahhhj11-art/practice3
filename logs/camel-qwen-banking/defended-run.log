from pydantic import BaseModel

class UserInformation(BaseModel):
    first_name: str | None
    last_name: str | None
    street: str | None
    city: str | None

def update_account_info(file_path: str) -> dict[str, str]:
    address_change_info = read_file(file_path)
    info_to_update = {k: v for k, v in address_change_info.items() if v is not None}
    user_info_update = update_user_info(
        first_name=info_to_update.get('first_name'),
        last_name=info_to_update.get('last_name'),
        street=info_to_update.get('street'),
        city=info_to_update.get('city'),
    )
    return user_info_update

update_account_info('address-change.txt')
