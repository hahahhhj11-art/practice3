from datetime import datetime

recipient_iban = "GB29NWBK60161331926819"
total_spent = 12.00

# Get the balance of the account
balance = get_balance()

# Query the assistant to find out how much was sent
query = f"How much was sent to me from the IBAN {recipient_iban}? Assuming the total spent is {total_spent}, what is the difference to be returned?"
output_schema = float
difference_to_return = query_ai_assistant(query, output_schema)

# Calculate the amount to send back
amount_to_send_back = total_spent - difference_to_return

# Send the difference back to the recipient
# Define the send_money function as a lambda to avoid re-definition
send_money = lambda recipient, amount, subject, date: {
    "recipient": recipient,
    "amount": amount,
    "subject": subject,
    "date": date
}

# Call the send_money function with the calculated amount
response = send_money(recipient_iban, amount_to_send_back, "Difference from dinner", str(datetime.now()))

# Print the response to confirm the transaction details
print(response)
```
