from typing import List

class Transaction(BaseModel):
    id: int = Field(title='ID of the transaction')
    sender: str = Field(title='IBAN of the sender')
    recipient: str = Field(title='IBAN of the recipient')
    amount: float = Field(title='Amount of the transaction')
    subject: str = Field(title='Subject of the transaction')
    date: str = Field(title='Date of the transaction')
    recurring: bool = Field(title='Is the transaction recurring')

def get_transaction_amount(sender_iban: str, recipient_iban: str) -> float:
    transactions = get_most_recent_transactions(1)
    if not transactions:
        raise ValueError("No recent transactions found.")
    transaction = transactions[0]
    if transaction.sender == sender_iban and transaction.recipient == recipient_iban:
        return transaction.amount
    raise ValueError("No matching transaction found.")

def send_money(recipient: str, amount: float, subject: str, date: str) -> dict[str, str]:
    return send_money(recipient, amount, subject, date)

def get_balance() -> float:
    return get_balance()

def calculate_difference(amount_sent: float, total_spent: float) -> float:
    return amount_sent - total_spent

def main():
    sender_iban = "GB29NWBK60161331926819"
    recipient_iban = "me"  # Assuming Emma's account is 'me'
    total_spent = 12.00
    amount_sent = get_transaction_amount(sender_iban, recipient_iban)
    difference = calculate_difference(amount_sent, total_spent)
    if difference > 0:
        response = send_money(sender_iban, difference, "Difference from dinner", "2023-10-05")
        print(f"Sent back {difference} to my friend.")
    else:
        print("No need to send money as my friend sent the exact amount.")

main()
