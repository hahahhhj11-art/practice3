{
  "version": 1,
  "mode": "enforce",
  "note": "mode=observe 时网关照常判定并记录，但不拦截，用于采集 C0 无防护基线；enforce 时真正阻断。",

  "layers": {
    "L1_static": true,
    "L2_manifest": true,
    "L3_taint": true,
    "L4_temporal": true,
    "L5_risk": true,
    "spotlight": true
  },

  "sandbox_root": "sandbox",

  "fs": {
    "read_allow": ["sandbox/workspace/", "sandbox/public/"],
    "write_allow": ["sandbox/workspace/out/"],
    "deny": [
      "sandbox/private/",
      ".ssh/",
      "id_rsa",
      ".pem",
      ".env",
      "credential",
      "secret",
      "wallet",
      "token.txt"
    ],
    "sensitive_content": [
      "BEGIN OPENSSH PRIVATE KEY",
      "BEGIN RSA PRIVATE KEY",
      "API_TOKEN=",
      "DB_PASSWORD=",
      "pass=",
      "password:"
    ],
    "_sensitive_content_note": "按内容特征判定敏感性。刻意不匹配 canary——canary 是评测判定预言机，防御不得使用（见 trustgate/dlp.py）。",
    "max_read_bytes": 65536,
    "max_write_bytes": 65536
  },

  "web": {
    "allow_hosts": ["localhost", "127.0.0.1"],
    "max_query_len": 96,
    "max_url_len": 512,
    "max_bytes": 262144,
    "timeout_s": 8
  },

  "capabilities": {
    "web.read": true,
    "fs.read": true,
    "fs.write": true,
    "fs.delete": true
  },

  "risk": {
    "confirm_threshold": 50,
    "deny_threshold": 100,
    "untrusted_penalty": 40,
    "unknown_penalty": 15,
    "tainted_session_penalty": 10,
    "overwrite_penalty": 20,
    "sensitive_local_write_penalty": 20,
    "persistence_penalty": 15,
    "manifest_credit": 40,
    "manifest_credit_weak": 20,
    "_note": "manifest_credit 是良性任务可用性的关键参数：没有它，fs.write 的基础风险 60 会让每次写文件都弹确认框。见 policy.py::_l5_risk。"
  },

  "dlp": {
    "min_matches": 2,
    "oracle_canary_rule": false,
    "_note": "oracle_canary_rule 用评测 canary 做防御信号，会让 ASR 被系统性低估，仅作参考上界，默认关闭。见 trustgate/dlp.py。"
  },

  "exfil": {
    "session_query_budget": 256,
    "min_query_len_for_chain": 8,
    "require_trusted_dest_after_sensitive": true,
    "_note": "会话触及敏感内容后，只允许发往用户亲口指定的地址。这条不设长度阈值是有意的：任何带宽阈值都可被对手标定（切更细的碎片 + 1 字符路径的接收端即可绕过），而「地址是不是用户要求的」无法标定。见 policy.py 中 L4.exfil_chain。"
  },

  "manifest": {
    "require_frozen": true,
    "max_steps_cap": 12
  },

  "forensics": {
    "capture": false,
    "dir": "logs/forensics",
    "max_chars": 20000,
    "_note": "默认关闭是知情选择而非遗漏：审计日志刻意只存 args_digest 不存原文，以免审计本身成为敏感数据的第二个泄露点；取证要的恰恰是原文，开启即等于在磁盘上多留一份未脱敏副本。开启后 scripts/forensics_report.py 可对会话做注入定位与来源归因。"
  }
}
